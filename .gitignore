# ============================================================
# Minecraft-on-Kubernetes .gitignore
# ============================================================

# ---- 機密情報（絶対にコミットしない）----
.env
.envrc
secret.yaml
*-secret.yaml
**/*_secret.yaml
onprem_kubeconfig.yaml
k8s/onprem/onprem_*
**/*_gcloud_auth_plugin_cache
# PlayersSync ConfigMap（DB パスワードを含む）
k8s/onprem/playersync-configmaps.yaml
# DeepSeekCode（機密情報を含む）
DeepSeekCode.sh
# GCE: 平文 secret は Secret Manager から動的取得する
**/forwarding.secret
# mc-monitoring-1: DISCORD_WEBHOOK は cloud-init が Secret Manager から生成
gce/monitoring/.env
gce/monitoring/alertmanager/secrets/
# Claude Code のローカル設定
.claude/settings.local.json

# ---- Terraform ----
Terraform/secret.tfvars
.terraform/
*.tfstate
*.tfstate.*
# .terraform.lock.hcl は provider バージョン固定のためコミットする（CI と揃える）
# plan ファイル（機密値を含む。tf-safe-apply の -out=tfplan も対象）
tfplan
*.tfplan
*.tfplan.binary
crash.log
# Cloud Function ビルドアーティファクト
Terraform/billing_notifier.zip
Terraform/cloud_function_source/mc-log-processor.zip

# ---- Python ----
__pycache__/
*.py[codz]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- ビルド成果物・ログ ----
build/
*.log

# ---- ローカル専用ファイル ----
# 手元スクリプト（gce/ 配下の運用スクリプトは管理対象として例外）
scripts/
!gce/scripts/
!gce/monitoring/scripts/
Task_mds/
DocMd/
ModList/
MC_addon-raw/
# VictoriaMetrics クエリ定義メモ
query.txt
sushiski-infra-context.md
session-context.md
Documents/Mermaids/roadmap.mermaid

# ---- Minecraft データ（大容量・バイナリ）----
world.zip
*.mcworld
*.mcaddon
*.mcpack
*.mctemplate
