{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Minecraft Java - Survival ステータス",
  "uid": "minecraft-java-overview",
  "tags": ["minecraft", "java"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "サーバー状態",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "稼働状態",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } } ], "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [ { "refId": "A", "expr": "minecraft_status_healthy{component=\"survival\"}" } ]
    },
    {
      "type": "stat",
      "title": "オンライン人数",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [ { "color": "blue", "value": null } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "minecraft_status_players_online_count{component=\"survival\"}", "legendFormat": "online" } ]
    },
    {
      "type": "stat",
      "title": "応答時間",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [ { "refId": "A", "expr": "minecraft_status_response_time_seconds{component=\"survival\"}" } ]
    },
    {
      "type": "stat",
      "title": "最大人数",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" },
      "targets": [ { "refId": "A", "expr": "minecraft_status_players_max_count{component=\"survival\"}", "legendFormat": "最大人数" } ]
    },
    {
      "type": "row",
      "title": "推移",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "プレイヤー数 推移",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 15, "showPoints": "never", "drawStyle": "line" } } },
      "targets": [
        { "refId": "A", "expr": "minecraft_status_players_online_count{component=\"survival\"}", "legendFormat": "online" },
        { "refId": "B", "expr": "minecraft_status_players_max_count{component=\"survival\"}", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "応答時間 推移",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 15, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "minecraft_status_response_time_seconds{component=\"survival\"}", "legendFormat": "response" } ]
    },
    {
      "type": "row",
      "title": "Pod リソース (deploy-survival)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "コンテナ CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"minecraft\", pod=~\"deploy-survival.*\", container!=\"\"}[5m]))", "legendFormat": "{{container}}" } ]
    },
    {
      "type": "timeseries",
      "title": "コンテナ メモリ (working set)",
      "datasource": { "type": "prometheus", "uid": "victoria-metrics" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 10, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"minecraft\", pod=~\"deploy-survival.*\", container!=\"\"})", "legendFormat": "{{container}}" } ]
    }
  ]
}
