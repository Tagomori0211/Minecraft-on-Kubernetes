[Unit]
Description=mc-gateway monitoring stack (VictoriaMetrics / VictoriaLogs / Grafana / vmalert / Alertmanager)
Documentation=https://github.com/Tagomori0211/Minecraft-on-Kubernetes
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mc-gateway
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
